{
  "name": "@tsctupper/otpkit",
  "version": "1.1.3",
  "description": "Zero-dependency, RFC-verified HOTP & TOTP (2FA / authenticator) codes for Node.js and TypeScript.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test test/*.test.ts",
    "coverage": "tsx --test --experimental-test-coverage --test-coverage-include='src/**' test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run check && npm run build"
  },
  "keywords": [
    "totp",
    "hotp",
    "otp",
    "2fa",
    "mfa",
    "authenticator",
    "google-authenticator",
    "two-factor",
    "rfc6238",
    "rfc4226",
    "rfc4648",
    "zero-dependency",
    "typescript"
  ],
  "author": "Tyler Tupper (https://github.com/tsctupper)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsctupper/otpkit.git"
  },
  "bugs": {
    "url": "https://github.com/tsctupper/otpkit/issues"
  },
  "homepage": "https://github.com/tsctupper/otpkit#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  }
}
